rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function role() {
      return signedIn() && 'role' in request.auth.token ? request.auth.token.role : 'CUSTOMER';
    }

    function isStaff() {
      return signedIn() && role() in ['OWNER', 'MANAGER', 'KITCHEN', 'DISPATCHER', 'FINANCE', 'MARKETING'];
    }

    function isAdmin() {
      return signedIn() && role() in ['OWNER', 'MANAGER'];
    }

    function isKitchen() {
      return signedIn() && role() in ['OWNER', 'MANAGER', 'KITCHEN'];
    }

    function isFinance() {
      return signedIn() && role() in ['OWNER', 'MANAGER', 'FINANCE'];
    }

    function isDispatcher() {
      return signedIn() && role() in ['OWNER', 'MANAGER', 'DISPATCHER'];
    }

    function isOwner() {
      return signedIn() && role() == 'OWNER';
    }

    function publishedMenu() {
      return resource.data.archivedAt == null;
    }

    match /_meta/{document} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /restaurants/{restaurantId} {
      allow read: if true;
      allow write: if false;

      match /menuCategories/{categoryId} {
        allow read: if publishedMenu() || isStaff();
        allow write: if false;
      }

      match /menuItems/{itemId} {
        allow read: if publishedMenu() || isStaff();
        allow write: if false;
      }

      match /modifierGroups/{groupId} {
        allow read: if true;
        allow write: if false;
      }

      match /deliveryZones/{zoneId} {
        allow read: if true;
        allow write: if false;
      }

      match /promotions/{promotionId} {
        allow read: if isAdmin() || role() == 'MARKETING';
        allow write: if false;
      }

      match /inventory/{sku} {
        allow read: if isStaff();
        allow write: if false;
      }

      match /counters/{name} {
        allow read, write: if false;
      }

      match /aggregates/{day} {
        allow read: if isFinance() || isAdmin();
        allow write: if false;
      }

      match /plans/{planId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    match /restaurants/_usages/promotionUsages/{usageId} {
      allow read, write: if false;
    }

    match /customers/{customerId} {
      allow read: if signedIn() && (uid() == customerId || isStaff());
      allow create, update: if signedIn() && uid() == customerId;
      allow delete: if false;

      match /addresses/{addressId} {
        allow read: if signedIn() && (uid() == customerId || isStaff());
        allow write: if false;
      }
    }

    match /users/{userId} {
      allow read: if signedIn() && (uid() == userId || isAdmin() || isOwner() || isKitchen());
      allow write: if false;
    }

    match /orders/{orderId} {
      allow read: if isStaff() || (signedIn() && resource.data.customerId == uid());
      allow create, update, delete: if false;

      match /events/{eventId} {
        allow read: if isStaff();
        allow write: if false;
      }
    }

    match /payments/{paymentId} {
      allow read: if isFinance();
      allow write: if false;
    }

    match /deliveries/{deliveryId} {
      allow read: if isDispatcher() || isKitchen() || isAdmin();
      allow write: if false;
    }

    match /printJobs/{jobId} {
      allow read: if isKitchen() || isAdmin();
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read, write: if false;
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'APPROVED'
        || isStaff()
        || (signedIn() && resource.data.customerId == uid());
      allow create: if signedIn()
        && request.resource.data.customerId == uid()
        && request.resource.data.status == 'PENDING'
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /idempotencyKeys/{key} {
      allow read, write: if false;
    }

    match /memberships/{membershipId} {
      allow read: if signedIn() && (resource.data.customerId == uid() || isStaff());
      allow write: if false;
    }

    match /webhookEvents/{eventId} {
      allow read, write: if false;
    }

    match /analyticsEvents/{eventId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /marketingSignups/{signupId} {
      allow read: if isAdmin() || role() == 'MARKETING';
      allow write: if false;
    }
  }
}
