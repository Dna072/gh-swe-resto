{
  "name": "ghana-restaurant",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade Ghanaian restaurant ordering and operations platform for Uppsala",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --dir src --dir tests/unit",
    "test:integration": "vitest run --dir tests/integration",
    "test:rules": "firebase emulators:exec --only firestore --project ghana-restaurant-test \"vitest run --config vitest.rules.config.ts\"",
    "test:all": "npm run test:unit && npm run test:rules",
    "emulators": "firebase emulators:start --only firestore,auth,storage --project ghana-restaurant-dev"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^20.0.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "firebase-tools": "^15.28.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
