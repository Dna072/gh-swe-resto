# Application
NODE_ENV=development
APP_ENV=development
APP_BASE_URL=http://localhost:3000
DEFAULT_RESTAURANT_ID=uppsala-main

# Firebase / GCP — never point local development at production
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ghana-restaurant-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=ghana-restaurant-dev
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
GOOGLE_CLOUD_PROJECT=ghana-restaurant-dev

# Local emulators (preferred for development)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Cloud Storage
GCS_ASSETS_BUCKET=ghana-restaurant-dev-assets

# Payments — sandbox only until a provider is actually tested
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Delivery — sandbox/mock until Wolt credentials are validated
DELIVERY_PROVIDER=mock
WOLT_DRIVE_API_BASE_URL=
WOLT_DRIVE_MERCHANT_ID=
WOLT_DRIVE_API_KEY=
FOODORA_API_BASE_URL=
FOODORA_API_KEY=

# Notifications
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
TRANSACTIONAL_FROM_EMAIL=orders@example.com

# Cloud Tasks / Pub/Sub (production/staging)
CLOUD_TASKS_LOCATION=europe-north1
CLOUD_TASKS_QUEUE_NOTIFICATIONS=notifications
CLOUD_TASKS_QUEUE_PRINT=print-jobs
PUBSUB_ANALYTICS_TOPIC=analytics-events

# Secrets are loaded from Secret Manager in Cloud Run.
# Local development uses this file and/or the Firebase emulator.
# Never commit real credentials.
