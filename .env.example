# Application
NODE_ENV=development
APP_ENV=development
APP_BASE_URL=http://localhost:3000
DEFAULT_RESTAURANT_ID=uppsala-main

# Firebase / GCP — never point local development at production
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ghana-restaurant-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=ghana-restaurant-dev
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
GOOGLE_CLOUD_PROJECT=ghana-restaurant-dev

# Local emulators (preferred for development)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Data store — memory for local demo; firestore on Cloud Run
DATA_STORE=memory

# Cloud Storage (set on Cloud Run so meal photos persist)
GCS_ASSETS_BUCKET=

# Payments — sandbox only until a provider is actually tested
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Delivery — sandbox until live Wolt/foodora credentials exist in Secret Manager.
# Never put provider secrets in NEXT_PUBLIC_* variables.
DELIVERY_PROVIDER=sandbox
GEOCODER_PROVIDER=
MAPTILER_API_KEY=
WOLT_DRIVE_API_BASE_URL=
WOLT_DRIVE_MERCHANT_ID=
WOLT_DRIVE_VENUE_ID=
WOLT_DRIVE_API_KEY=
WOLT_WEBHOOK_SECRET=
FOODORA_API_BASE_URL=
FOODORA_API_KEY=
FOODORA_WEBHOOK_SECRET=
NEXT_PUBLIC_MAP_STYLE_URL=

# Optional Google Maps server geocoder (not required). Prefer MapTiler or OSM Photon.
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Notifications
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
TRANSACTIONAL_FROM_EMAIL=orders@mfcuisine.se

# Amazon SES (keep GCP for the app; SES is email only). Verify mfcuisine.se in SES.
# EMAIL_PROVIDER=ses
AWS_SES_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=orders@mfcuisine.se
SES_FROM_NAME=Meridian Fusion Cuisine
SES_CONFIGURATION_SET=

# Public hosts (one Cloud Run service; middleware maps host → app)
PUBLIC_APP_HOST=mfcuisine.se
ADMIN_APP_HOST=admin.mfcuisine.se
KITCHEN_APP_HOST=kitchen.mfcuisine.se
ADMIN_APP_BASE_URL=https://admin.mfcuisine.se
KITCHEN_APP_BASE_URL=https://kitchen.mfcuisine.se

# Cloud Tasks / Pub/Sub (production/staging)
CLOUD_TASKS_LOCATION=europe-north1
CLOUD_TASKS_QUEUE_NOTIFICATIONS=notifications
CLOUD_TASKS_QUEUE_PRINT=print-jobs
PUBSUB_ANALYTICS_TOPIC=analytics-events

# Local admin (never set in production). Bearer token for /admin meal media.
ADMIN_DEV_TOKEN=dev-admin-token

# Secrets are loaded from Secret Manager in Cloud Run.
# Required for live last-mile (never in frontend or source):
#   WOLT_DRIVE_API_KEY, WOLT_WEBHOOK_SECRET, WOLT_DRIVE_VENUE_ID
#   FOODORA_API_KEY, FOODORA_WEBHOOK_SECRET (only after a documented last-mile contract)
#   MAPTILER_API_KEY (production OSM-compatible geocoding)
# Local development uses this file and/or the Firebase emulator.
# Never commit real credentials.
